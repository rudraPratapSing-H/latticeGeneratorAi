# Backend settings. Copy to .env: scripts/dev.ps1 reads .env (KEY=VALUE lines) for variables that are not already set.
# Plain `python -m uvicorn server.app:app` does not read this file: set them in PowerShell with  $env:NAME = "value".
# Everything here is optional; the defaults work on the GPU laptop.

# Mock mode: replay stored real runs and the stored demo targets, no GPU (1 = on)
# MOCK=1

# Where the model files are (default: the repo folder) and which predictor file to use
# MODEL_DIR=
# PREDICTOR=q1.pt

# cuda:0 or cpu (default: cuda:0 when torch sees a GPU)
# DEVICE=

# Solver worker processes (default: free cores minus one) and the worker priority switch used for benchmarks
# WORKERS=
# SOLVER_PRIORITY=

# Search: stop escalating after this many seconds (default 120); override the K ladder, e.g. 300 or 100,300,1000
# TIME_BUDGET_S=120
# K_LADDER=100,300,1000

# Jobs: how many may wait (default 10, then HTTP 429); where jobs and results are stored (default: runs/)
# MAX_QUEUE=10
# RUNS_DIR=

# Server-sent events heartbeat seconds (default 15); mock mode delay per stage (default 0.3)
# SSE_PING_S=15
# MOCK_STAGE_DELAY=0.3

# Labels folder for the GPU tests and benchmarks (default ../strength-labels)
# LABELS_DIR=
