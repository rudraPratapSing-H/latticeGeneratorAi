meta {
  name: 8 Create design (impossible)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/designs
  body: json
  auth: none
}

body:json {
  {
    "material": "ti64",
    "part": {
      "size_mm": [
        40,
        40,
        40
      ],
      "cell_mm": 10
    },
    "target": {
      "stiffness_gpa": {
        "x": 20,
        "y": 20,
        "z": 20
      },
      "max_mass_g": 60
    }
  }
}

script:post-response {
  bru.setVar("jobId", res.body.job_id);
}

tests {
  test("422 with the bound", function() { expect(res.status).to.equal(422); expect(res.body.error.code).to.equal("bad_target"); expect(res.body.error.reach.level).to.equal("infeasible"); expect(res.body.error.message).to.include("GPa"); });
}

docs {
  20+20+20 GPa at 60 g is above density x E_s. The picker rejects it up front with 422, the bound and the nearest achievable target (error.reach). Send force: true to search anyway (request 12).
}
