meta {
  name: 9 Limits
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/limits?material=ti64
  body: none
  auth: none
}

tests {
  test("200 and three densities", function() { expect(res.status).to.equal(200); expect(res.body.densities.length).to.equal(3); expect(res.body.densities[2].strength_mpa.max).to.be.above(70); });
}

docs {
  What the dataset covers for this material: per relative density 0.05 / 0.15 / 0.25, the min / median / max stiffness (GPa) and strength (MPa), the stiffness-sum bound (density x E_s) and the strength maximum. For form hints and validation.
}
