meta {
  name: D5 medium, much stiffer in x
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/designs
  body: json
  auth: none
}

body:json {
  {
    "material": "ti64",
    "part": {
      "size_mm": [
        40,
        40,
        40
      ],
      "cell_mm": 10
    },
    "target": {
      "stiffness_gpa": {
        "x": 1.62,
        "y": 0.306,
        "z": 0.509
      },
      "strength_mpa": {
        "x": 7.51,
        "y": 2.06,
        "z": 2.93
      },
      "max_mass_g": 43.4
    },
    "modes": {
      "stiffness": "about",
      "strength": "at_least",
      "weight": "at_most"
    },
    "tolerance_pct": 10,
    "n_results": 5
  }
}

script:post-response {
  bru.setVar("jobId", res.body.job_id);
}

tests {
  test("202", function() { expect(res.status).to.equal(202); });
}

docs {
  Taken from dataset lattice 121587 (rho 0.15, not in the 100k the predictor trained on): its stiffness, 95% of its strength, mass cap = its mass + 2%. A design must exist, so this should match. Then GET /api/jobs/{{jobId}} until done.
}
