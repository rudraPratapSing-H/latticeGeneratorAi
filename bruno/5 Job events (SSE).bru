meta {
  name: 5 Job events (SSE)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/jobs/{{jobId}}/events
  body: none
  auth: none
}

docs {
  Stream of state changes (status, stage, round, k, progress, message, queue_position) with a comment ping every 15 s, ending with an event named close. If the stream drops, poll request 4 every 2 s. Needs a recent Bruno with SSE support; otherwise open the URL in a browser.
}
