meta {
  name: 12 Create design (force: true on an infeasible target)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/designs
  body: json
  auth: none
}

body:json {
  {
    "material": "ti64",
    "part": {
      "size_mm": [
        40,
        40,
        40
      ],
      "cell_mm": 10
    },
    "modes": {
      "stiffness": "about",
      "strength": "at_least",
      "weight": "at_most"
    },
    "tolerance_pct": 10,
    "n_results": 5,
    "target": {
      "stiffness_gpa": {
        "x": 20,
        "y": 20,
        "z": 20
      },
      "max_mass_g": 60
    },
    "force": true
  }
}

script:post-response {
  bru.setVar("jobId", res.body.job_id);
}

tests {
  test("202 with force", function() { expect(res.status).to.equal(202); });
}

docs {
  20+20+20 GPa at 60 g is above density x E_s. Without force this is a 422 (request 8); with force the search runs one round and shows the closest designs, with a warning.
}
